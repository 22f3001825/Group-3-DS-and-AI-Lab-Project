# Copy to terraform.tfvars (gitignored) and fill in. Only the first two have no default.
#
#   cd deploy\terraform
#   Copy-Item terraform.tfvars.example terraform.tfvars
#   terraform init
#   terraform plan
#
# Run this as an ADMIN identity, not as the mlt-tf-staging-ops user it creates: applying
# needs iam:CreateRole + iam:PutRolePolicy + iam:PassRole, which together are administrator
# access in practice.

# ── Required ──────────────────────────────────────────────────────────────────

# An EXISTING EC2 key pair, by name (no .pem, no path). Terraform never generates one —
# a generated private key is written to terraform.tfstate in plaintext.
#   aws ec2 describe-key-pairs --query 'KeyPairs[].KeyName' --output text
key_pair_name = "iitm-2026"

# Your public address. Ports 80/443 are open to the world by necessity; 22 is the only
# rule that can be narrowed, so narrow it.
#   (Invoke-RestMethod https://checkip.amazonaws.com).Trim() + "/32"
ssh_cidr = "203.0.113.4/32"

# ── Defaults worth knowing about ──────────────────────────────────────────────

# region      = "ap-south-1"
# name_prefix = "mlt-tf"          # NOT "mlt": mlt-ec2-ecr / mlt-staging-ops already exist

# A NEW repository, alongside the existing iitm/ailab. Changing it means updating the
# ECR_REPOSITORY GitHub repository variable and re-running the build workflow.
# ecr_repository_name = "iitm/ailab-tf"

# github_repo = "22f3001825/Group-3-DS-and-AI-Lab-Project"
# github_ref  = "refs/heads/main"   # pushes from other branches will NOT be authorised
# github_sub_wildcard = false       # true = any ref in that one repo

# The GitHub OIDC provider is ACCOUNT-UNIQUE and already exists in account 512705760700.
# Leave false unless you are applying into a fresh account.
# create_github_oidc_provider = false

# instance_type  = "t3.micro"     # x86-64 only; the image is linux/amd64
# root_volume_gb = 16

# create_cliproxy_repo = true
# create_ops_user      = true

# EventBridge Scheduler rule that stops the box overnight.
# enable_nightly_stop     = true
# nightly_stop_expression = "cron(0 23 * * ? *)"
# nightly_stop_timezone   = "Asia/Kolkata"
