# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
bin/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual Environments
.venv/
venv/
ENV/
env/

# Editor / IDE settings
.idea/
.vscode/
*.swp
*.swo

# Local configuration
llm_config.json
chrome_debug_user_data/
discourse_scraper/chrome_debug_user_data/

# Data outputs (optional, depending on project storage constraints)
# Keep raw structure, ignore processed outputs if they are too large
data/processed/*.json
Discourse_scrapper/discourse_export.json
Discourse_scrapper/discourse_topics.csv
Discourse_scrapper/discourse_posts.csv
Discourse_scrapper/discourse_users.csv
Discourse_scrapper/topic_errors.jsonl
Discourse_scrapper/error.log
Discourse_scrapper/imgs/
Discourse_scrapper/state.json

# Environment Variables
.env
# Real per-environment files. The *.example templates below are deliberately re-included:
# they document the required shape and carry no secrets.
.env.*
!.env.staging.example
!.env_example

# Deployment state on a server checkout: the live SQLite DB and its nightly backups.
# Never committed — it holds real learner data.
state/

# CLIProxyAPI: the real config carries the proxy's api-keys, and cliproxy/ holds the
# provider OAuth credentials. deploy/cliproxy.config.example.yaml documents the shape.
deploy/cliproxy.config.yaml
cliproxy/

# SQLite Database (auto-generated at runtime)
*.db

# React Frontend
web/node_modules/
web/dist/
web/.vite/

# Terraform (infra/reranker)
# .terraform/ is the downloaded provider cache — 686 MB of platform-specific binaries
# that `terraform init` recreates on demand. The LOCK FILE is deliberately NOT ignored:
# it pins provider versions, so it belongs in the repository.
**/.terraform/
*.tfstate
*.tfstate.*
# Holds var.api_key, the reranker's shared secret.
*.tfvars
*.tfvars.json
crash.log
override.tf
override.tf.json

