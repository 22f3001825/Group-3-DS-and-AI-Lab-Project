QDRANT_URL= your_QDRANT_URL
QDRANT_API_KEY= your_api_key
GOOGLE_API_KEY= gemini_api
GROQ_API_KEY= groq_api

# Which provider is tried first: gemini (default) | groq | local
# This is the STARTING point only. An admin can reorder the whole hierarchy from
# Settings → LLM providers (PUT /admin/settings/llm-providers), which is stored in the
# database and overrides this value for every user until it is changed again. Keys and
# base URLs are still configured here — the setting ranks providers, it cannot enable one.
LLM_PROVIDER= gemini

# ── Local / self-hosted OpenAI-compatible endpoint (optional, for testing) ──────
# Setting LOCAL_LLM_BASE_URL is what enables the 'local' provider; leave it unset
# and the provider queue is exactly the hosted Gemini/Groq one. A bare host:port is
# normalised to /v1. Requires: pip install langchain-openai
# LOCAL_LLM_BASE_URL= http://localhost:8317/v1
# LOCAL_LLM_API_KEY= your_local_key
# LOCAL_LLM_MODELS= kimi-k2
# LOCAL_LLM_TIMEOUT= 120
#
# Thinking level sent as OpenAI `reasoning_effort`. A model named claude-* defaults to
# `low` because an Anthropic-backed proxy (CLIProxyAPI) attaches Claude Code's
# clear_thinking context edit, which Anthropic rejects unless thinking is on. Set a
# different level to change it, or `off` to omit the field for a plain local server.
# LOCAL_LLM_REASONING_EFFORT= low

# ── Google sign-in (the only way into the app) ─────────────────────────────────
# Copy these four lines into .env and fill them in, or the first login 503s with no
# explanation. The client ID must be the SAME value as web/.env's VITE_GOOGLE_CLIENT_ID,
# or Google's `aud` check fails.
GOOGLE_CLIENT_ID=       # OAuth 2.0 Web client ID from Google Cloud Console
JWT_SECRET=             # long random string. UNSET ⇒ every auth endpoint 503s, like ADMIN_TOKEN
ADMIN_EMAILS=           # comma-separated; these get is_admin AND bypass the domain check
ALLOWED_EMAIL_DOMAINS=  # comma-separated, e.g. ds.study.iitm.ac.in. EMPTY = any Google account

# Browser origins allowed to call this API. Empty falls back to the two Vite ports below.
CORS_ORIGINS=http://localhost:5173,http://localhost:4173

# ── Cross-encoder reranker (optional) ──────────────────────────────────────────
# A separate service that re-scores retrieved chunks against the question before the LLM
# sees them, too heavy to run inside the API process.
#
# These two only tell the API HOW to reach it. Whether it is used is a runtime toggle in
# Settings → Retrieval → Cross-encoder reranking (admins only), stored in app_settings.
# Leave both unset and the toggle is inert — the endpoint cannot be switched on by
# accident, and retrieval keeps Qdrant's RRF ordering exactly as before.
#
# On staging it is a container in the same compose stack (profile `reranker`), so the URL
# is the SERVICE NAME — it publishes no host port, and localhost will not reach it. The
# alternative is a standalone instance (infra/reranker/), whose URL is its private IP.
# RERANKER_URL= http://reranker:8080
# RERANKER_API_KEY= the_same_long_random_string_both_containers_read

# Candidates the chat path pulls from Qdrant. The reranker can only choose from what it
# is given: at 10 with top_k=5 it picks the best 5 of 10. Raise to ~20 to widen the field.
# Harmless when the reranker is off — the pipeline truncates to top_k either way.
# CHAT_RETRIEVAL_K= 10

# ── Admin content authoring (question intelligence) ────────────────────────────
# A single shared secret sent as the X-Admin-Token header, kept as the ops/scripts
# fallback beside Google sign-in: it carries no identity, so any admin is every admin.
# The identified path is ADMIN_EMAILS above, which sets `is_admin` on the student row at
# each login. With BOTH this and JWT_SECRET unset, every admin endpoint returns 503 — an
# unconfigured deployment is closed, not wide open.
# ADMIN_TOKEN= a_long_random_string
