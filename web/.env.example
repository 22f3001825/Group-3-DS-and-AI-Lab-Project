# Copy to web/.env and fill in. Vite only exposes variables prefixed VITE_, and it reads
# them at BUILD time — restart `npm run dev` after editing this file.

# The SAME OAuth 2.0 Web client ID as GOOGLE_CLIENT_ID in the repo-root .env. If the two
# disagree, Google's `aud` check fails and every sign-in 401s.
VITE_GOOGLE_CLIENT_ID=

# Where the FastAPI backend lives. Defaults to http://localhost:8000 when unset.
VITE_API_URL=http://localhost:8000
